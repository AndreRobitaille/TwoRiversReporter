{
  "permissions": {
    "allow": [
      "Bash(bin/rubocop:*)",
      "Bash(bin/rails test:*)",
      "Bash(bin/rails runner:*)",
      "Bash(bin/rails routes:*)",
      "Bash(bin/rails db:migrate:status:*)",
      "Bash(bin/ci:*)",
      "Bash(bin/brakeman:*)",
      "Bash(bin/bundler-audit:*)",
      "Bash(bin/importmap audit:*)",
      "Bash(bin/jobs:*)",
      "Bash(bin/dev:*)",
      "Bash(bundle install:*)",
      "Bash(bundle exec:*)",
      "Bash(bundle show:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git worktree:*)",
      "Bash(git check-ignore:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh api:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(agent-browser:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "path=$(jq -r '.tool_input.file_path // empty'); echo \"$path\" | grep -qE '(master\\.key$|/\\.env(\\..+)?$|credentials\\.yml\\.enc$)' && { echo \"Blocked: $path is a secret file. Edit it manually.\" >&2; exit 2; }; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && jq -r '.tool_input.file_path // empty' | grep -E '\\.(rb|rake)$' | xargs -r bin/rubocop -a --force-exclusion 2>&1 || true"
          }
        ]
      }
    ]
  }
}
