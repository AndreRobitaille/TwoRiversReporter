<h1>Sign in</h1>

<%= tag.div(flash[:alert]) if flash[:alert] %>
<%= tag.div(flash[:notice]) if flash[:notice] %>

<%= form_with url: public_session_path, method: :post do |form| %>
  <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "Enter your email address", value: params[:email_address] %>
  <%= form.submit "Send magic link" %>
<% end %>

<button type="button" data-controller="passkey" data-action="passkey#authenticate">Sign in with passkey</button>
