<% if @record_period.selectable.any? %>
  <%= form_with url: member_path(@member), method: :get, class: "member-record-period" do |form| %>
    <div class="member-record-period-choice">
      <%= form.label :term, "Council record", class: "form-label" %>
      <%= form.select :term, @record_period.selectable.map { |period| [council_period_label(period), period.period_key] } + [["All available records", "all"]], { selected: @record_period.key }, class: "form-select" %>
    </div>
    <%= form.hidden_field :votes, value: "all", id: nil if @show_all_votes %>
    <% @vote_filters&.query_params&.each do |key, value| %>
      <%= form.hidden_field key, value: value, id: nil %>
    <% end %>
    <%= form.submit "Show record", name: nil, class: "btn btn--secondary" %>
  <% end %>
<% end %>
