<span class="roll-call">
  <span class="roll-call-caption"><%= vote.fetch("caption") %></span>
  <span class="roll-call-result"><%= vote.fetch("title") %> · Passed <%= vote.fetch("ayes") %>–<%= vote.fetch("nays") %> · <time datetime="<%= vote.fetch("date") %>"><%= Date.iso8601(vote.fetch("date")).strftime("%b %-d, %Y") %></time></span>
</span>
