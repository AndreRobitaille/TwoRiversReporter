<div class="member-campaign-vote">
  <p><%= action.fetch(:reason) %></p>
  <% if action.dig(:evidence, "conditions").present? %><p><%= action.dig(:evidence, "conditions") %></p><% end %>
  <blockquote><%= action.fetch(:source_quote) %></blockquote>
  <%= link_to action.fetch(:citation).fetch(:label), action.fetch(:citation).fetch(:source_url) || meeting_path(action.fetch(:meeting)), class: "member-campaign-meeting" %>
</div>
