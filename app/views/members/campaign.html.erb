<% content_for(:title) { "#{@member.name} — Campaign statements and Council actions" } %>
<article class="member-article">
  <%= render "profile_header" %>
  <p class="member-profile-nav"><%= link_to "Back to #{@member.name}’s profile", member_path(@member) %></p>
  <%= render "selected_statement" %>
  <% if gated_for_visitor? %>
    <%= render "shared/gate" %>
  <% else %>
    <%= render "election_context" %>
    <% if @answer_reviews.present? %>
      <%= gated_content { render "campaign_answers", reviews: @answer_reviews } %>
    <% end %>
    <% if @campaign_statements.any? %>
      <%= render "campaign_statements", statements: @campaign_statements %>
    <% elsif @answer_reviews.blank? %>
      <p>We don’t have a sourced campaign statement for <%= @member.name %> yet.</p>
    <% end %>
  <% end %>
</article>
