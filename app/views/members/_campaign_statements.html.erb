<%= gated_content do %>
  <section class="member-article-section" id="campaign-record">
    <div class="home-section-header">
      <%= render "shared/atom_marker" %>
      <h2 class="section-label" id="campaign-record-heading">What they ran on</h2>
      <span class="section-line"></span>
    </div>
    <% statements.group_by { |statement| statement.campaign_source_version.election_on }.each do |election, records| %>
      <% platform = @campaign_platforms.fetch(election) %>
      <% records = platform.statements %>
      <% next if records.empty? %>
      <h3 class="member-campaign-election" id="campaign-year-<%= election.iso8601 %>"><%= election.strftime("%B %-d, %Y") %> election</h3>
      <% issues = @campaign_issues.fetch(election, []) %>
      <% if platform.items.any? %>
        <div class="member-campaign-list">
          <% platform.items.each_with_index do |item, index| %>
            <%= render "campaign_item", item: item, election: election, expanded: params[:priority].present? ? params[:priority] == campaign_item_anchor(election, item) : index.zero? %>
          <% end %>
        </div>
      <% end %>
      <% if issues.any? %>
        <div class="member-campaign-list">
          <% issues.each_with_index do |issue, index| %>
            <%= render "campaign_issue", issue: issue, expanded: platform.items.empty? && index.zero? %>
          <% end %>
        </div>
      <% end %>
      <% if issues.any? || platform.unreviewed.size < records.size %>
        <details class="member-campaign-evidence">
          <summary><%= platform.items.any? ? "Sources for these campaign positions" : "Campaign sources and full statements" %> (<%= records.size %>)</summary>
          <%= render partial: "campaign_statement", collection: records, as: :record %>
        </details>
      <% else %>
        <div class="member-campaign-list">
          <%= render partial: "campaign_statement", collection: records.first(3), as: :record %>
        </div>
        <% if records.size > 3 %>
          <details class="member-campaign-overflow">
            <summary><%= pluralize(records.size - 3, "more campaign statement") %></summary>
            <div class="member-campaign-list">
              <%= render partial: "campaign_statement", collection: records.drop(3), as: :record %>
            </div>
          </details>
        <% end %>
      <% end %>
    <% end %>
  </section>
<% end %>
