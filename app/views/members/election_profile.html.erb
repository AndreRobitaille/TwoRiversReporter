<% content_for(:title) { "#{@member.name} — Council term and voting record" } %>
<% content_for(:description) { "#{@member.name}’s campaign priorities, work on the Two Rivers City Council and public meeting records." } %>
<% content_for(:og_type) { "article" } %>

<article class="member-article election-profile" data-controller="profile-disclosures"
         data-action="hashchange@window->profile-disclosures#reveal">
  <%= render "profile_header" %>
  <%= gated_content do %>
    <% if params[:decision].present? %>
      <section id="profile-decision" class="member-article-section">
        <% if @linked_vote %>
          <% motion = @linked_vote.motion %>
          <h2><%= member_decision_title(motion) %></h2>
          <% if motion.description.present? && motion.description != member_decision_title(motion) %>
            <p><%= motion.description %></p>
          <% end %>
          <p><%= @member.name %>’s recorded vote: <strong><%= @linked_vote.value&.humanize || "Unrecorded" %></strong>.
            Decision: <%= motion.outcome&.humanize || "Unrecorded" %> (<%= vote_split(motion) %>).</p>
          <% if (minutes = ResidentContent::VoteMinutes.for(motion)) %>
            <%= profile_source_link minutes.fetch(:label), minutes.fetch(:source_url), agenda_title: motion.agenda_item&.title %> ·
          <% end %>
          <%= link_to "#{motion.meeting.starts_at.to_date.to_fs(:long)} meeting and sources", meeting_path(motion.meeting) %>
        <% else %>
          <p>This vote is no longer available in this member’s record.</p>
        <% end %>
      </section>
    <% end %>
    <% report = @term_summary if @term_summary&.sentences.present? %>
    <% findings = report ? ResidentContent::CampaignPlatform.reviewed_findings(report, @member.name) : [] %>
    <% scored_headings = findings.flat_map { |finding| finding["heading"].to_s.split(" / ") } %>
    <% reviews = Array(@answer_reviews).reject { |review| scored_headings.include?(review["promise_heading"]) } %>
    <% if report %>
      <% term_end = ResidentContent::CouncilElection.scheduled_term_end(@member.name, @record_period.selected) %>
      <% pace = CouncilProfiles::PromisePace.new(started_on: report.term_started_on, ends_on: term_end) %>
      <% score = CouncilProfiles::PromiseFollowThrough.new(findings, elapsed: pace.elapsed) %>
      <% groups = findings.each_with_index.group_by { |item, _index| item.fetch("status") } %>
    <% end %>
    <div class="profile-reading-layout">
      <section class="member-term-overview" id="campaign-record" aria-labelledby="term-heading">
        <h2 id="term-heading"><%= profile_term_heading %></h2>
        <% if report %>
          <%= render "term_report", report: report, groups: groups, score: score, pace: pace %>
        <% elsif @campaign_preview.present? %>
          <p class="member-term-date"><%= @campaign_date.year %> Council campaign</p>
          <% @campaign_preview.each do |description, statement| %>
            <p class="member-term-copy"><%= description %> <%= link_to "Source", campaign_member_path(@member, statement: statement.id, anchor: "campaign-statement"), class: "member-term-source" %></p>
          <% end %>
        <% elsif @candidate_campaigns.any? { |campaign| campaign.year == @record_period.selected&.started_on&.year && campaign.missed_forums_and_surveys? } %>
          <p>These forums and questionnaires provide no campaign position to assess for this term.</p>
        <% else %>
          <p>We haven’t published a summary of this member’s last campaign yet.</p>
        <% end %>
        <%= render "election_context" %>
        <% if findings.empty? %>
          <%= link_to "Read the full campaign record", campaign_member_path(@member, anchor: "campaign-record"), class: "profile-campaign-link" %>
        <% end %>
      </section>
      <%= render "council_work" %>
      <% if findings.any? %>
        <%= render "campaign_promises", report: report, groups: groups, pace: pace, score: score, reviews: reviews %>
      <% end %>
      <% if reviews.any? %>
        <%= render "campaign_answers", reviews: reviews %>
      <% end %>
    </div>
  <% end %>
</article>
