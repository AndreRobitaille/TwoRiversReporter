<details class="member-campaign-issue" id="<%= campaign_item_anchor(election, item) %>" <%= "open" if expanded %> data-campaign-proposal>
  <summary class="member-campaign-summary">
    <span><%= item.fetch(:heading) %><span class="member-campaign-qualification"><%= item.fetch(:kind) %></span></span>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 5 7 7-7 7"/></svg>
  </summary>
  <% records = item.fetch(:statements) %>
  <% actions = campaign_item_actions(item) %>
  <%= render "campaign_comparison", statement: records.first, actions: actions, item: item %>
  <% reports = item.fetch(:reports, []) %>
  <% if reports.any? %>
    <h4 class="member-campaign-activity-heading">From the public record</h4>
    <% reports.each do |report| %>
      <div class="member-campaign-action" data-campaign-report>
        <p><%= report.fetch("text") %></p>
        <p class="member-campaign-source"><%= safe_join(report.fetch("sources").map { |source| link_to source.fetch("label"), source.fetch("url") }, " · ") %></p>
      </div>
    <% end %>
  <% end %>
  <% if actions.empty? && reports.empty? %>
    <p class="member-campaign-empty">We haven’t linked a council action to this position yet.</p>
  <% end %>
  <details class="member-campaign-context">
    <summary>Campaign sources</summary>
    <% records.map(&:campaign_source_version).uniq.each do |source| %>
      <p><%= link_to source.publisher, source.source_url %><%= " · #{source.published_on.to_fs(:long)}" if source.published_on %></p>
    <% end %>
  </details>
</details>
