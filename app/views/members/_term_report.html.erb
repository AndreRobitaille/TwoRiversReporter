<% findings = ResidentContent::CampaignPlatform.reviewed_findings(report, @member.name) %>
<% score = CouncilProfiles::PromiseFollowThrough.new(findings) %>
<% term_end = ResidentContent::CouncilElection.scheduled_term_end(@member.name, @record_period.selected) %>
<% pace = CouncilProfiles::PromisePace.new(score, started_on: report.term_started_on, ends_on: term_end) %>
<% groups = findings.each_with_index.group_by { |item, _index| item.fetch("status") } %>
<% emphasis = ResidentContent::CampaignPlatform::EDITION.dig("members", @member.name, "story_emphasis") || [] %>
<% campaign, in_office = report.sentences.partition do |sentence|
     sources = sentence.fetch("sources")
     sources.any? && sources.all? { |source| @campaign_source_urls.include?(source.fetch("url")) }
   end %>
<% if findings.any? %>
  <section class="promise-report" aria-label="Campaign promise results and term pace" data-pace="<%= pace.rating %>">
    <% if pace.rating %><h3 class="pace-label"><%= pace.label %></h3><% end %>
    <div class="promise-meter" data-negative="<%= score.net_points.negative? %>">
      <span class="member-term-score"><strong><%= score.percentage %>%</strong> promise score</span>
      <meter min="0" max="100" value="<%= score.percentage.abs %>" aria-label="<%= score.net_points.negative? ? "Net percentage below zero" : "Net promise score" %>"><%= score.percentage.abs %>%</meter>
    </div>
    <% if pace.rating %>
      <div class="promise-meter term-clock">
        <span><strong><%= pace.elapsed_percent %>%</strong> of term elapsed</span>
        <meter min="0" max="100" value="<%= pace.elapsed_percent %>" aria-label="Council term elapsed"><%= pace.elapsed_percent %>%</meter>
      </div>
    <% end %>
    <p class="member-term-copy score-lead"><%= score.lead %>
      <% if pace.days_left&.positive? %><%= pluralize(pace.days_left, "day") %> left.<% end %>
    </p>
    <% if groups["contrary"] %>
      <ul class="score-deductions">
        <% groups.fetch("contrary").each do |item, index| %>
          <li><%= link_to "#promise-#{index + 1}", data: { turbo: false } do %>
            <strong>−1</strong><span>Reversal · <%= item["profile_subject"] || item["heading"].presence || item.fetch("label") %></span>
          <% end %></li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>

<div class="term-narrative">
  <dl class="term-digest">
    <% { "Ran on" => campaign, "In office" => in_office }.each do |label, passages| %>
      <% next if passages.empty? %>
      <div>
        <dt><%= label %></dt>
        <dd>
          <% passages.each do |passage| %>
            <p class="member-term-copy"><%= highlight(h(passage.fetch("text")), emphasis, highlighter: '<strong>\1</strong>') %></p>
          <% end %>
        </dd>
      </div>
    <% end %>
    <% if groups["missed"] %>
      <div class="term-misses">
        <dt>Missed <%= "opportunity".pluralize(groups["missed"].size) %></dt>
        <dd>
          <ul>
            <% groups.fetch("missed").each do |item, _index| %>
              <li><%= item["profile_subject"] || item["heading"].presence || item.fetch("label") %></li>
            <% end %>
          </ul>
        </dd>
      </div>
    <% end %>
  </dl>
  <details class="member-term-sources story-notes">
    <summary>Sources for the term overview</summary>
    <ol>
      <% report.sentences.each do |sentence| %>
        <li>
          <p><%= sentence.fetch("text").truncate(85, separator: " ") %></p>
          <ul>
            <% sentence.fetch("sources").each do |source| %>
              <li><%= link_to source.fetch("label"), source.fetch("url") %></li>
            <% end %>
          </ul>
        </li>
      <% end %>
      <% groups.fetch("missed", []).each do |item, _index| %>
        <li>
          <p><%= item["profile_subject"] || item["heading"].presence || item.fetch("label") %></p>
          <ul>
            <% item.fetch("sources").reject { |source| @campaign_source_urls.include?(source.fetch("url")) }.each do |source| %>
              <li><%= profile_source_link source.fetch("label"), source.fetch("url"), finding: item["heading"] %></li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ol>
  </details>
</div>

<% if findings.any? %>
  <section class="promise-breakdown" id="promise-index" aria-labelledby="outcomes-heading">
    <h3 id="outcomes-heading">Campaign promises</h3>
    <% CouncilProfiles::PromiseFollowThrough::LABELS.each do |status, label| %>
      <% group = groups[status] %>
      <% next unless group %>
      <section class="promise-group" data-status="<%= status %>">
        <h4 class="outcome-heading">
          <span class="outcome-count"><%= group.size %></span>
          <span class="outcome-label"><%= %w[met missed].include?(status) ? label.pluralize(group.size) : label %></span>
          <span class="outcome-marks" aria-hidden="true"><% group.size.times do %><i></i><% end %></span>
        </h4>
        <ul class="member-promise-list">
          <% group.each do |item, index| %>
            <li><details id="promise-<%= index + 1 %>" class="promise-finding">
              <summary>
                <span class="linked-finding-status"><%= label %> · <%= { "met" => "1 point", "contrary" => "−1 point" }.fetch(status, "0 points") %></span>
                <span class="promise-title"><%= item["profile_subject"] || item["heading"].presence || item.fetch("label") %></span>
                <% if item["roll_call"] %>
                  <%= render "roll_call", vote: item.fetch("roll_call") %>
                <% else %>
                  <span class="promise-excerpt<%= " promise-reason" unless item["profile_excerpt"] %>"><%= item["profile_excerpt"] || item.fetch("reason") %></span>
                <% end %>
              </summary>
              <div class="finding-body">
                <% if item["profile_excerpt"] || item["roll_call"] %><p class="promise-reason"><%= item.fetch("reason") %></p><% end %>
                <% if item["finding_detail"] %><p class="finding-detail"><%= item["finding_detail"] %></p><% end %>
                <% campaign, evidence = item.fetch("sources").partition { |source| @campaign_source_urls.include?(source.fetch("url")) } %>
                <% if evidence.any? %>
                  <div class="finding-sources">
                    <strong>Supporting <%= "record".pluralize(evidence.size) %></strong>
                    <ul>
                      <% evidence.each do |source| %>
                        <li><%= profile_source_link source.fetch("label"), source.fetch("url"), finding: item["heading"] %></li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>
                <% if item["quote"].present? || campaign.any? %>
                  <details class="promise-wording">
                    <summary>Campaign wording and sources</summary>
                    <% if item["quote"].present? %>
                      <blockquote><q><%= item["quote"] %></q></blockquote>
                    <% end %>
                    <ul>
                      <% campaign.each do |source| %>
                        <li><%= link_to source.fetch("label"), source.fetch("url") %></li>
                      <% end %>
                    </ul>
                  </details>
                <% end %>
              </div>
            </details></li>
          <% end %>
        </ul>
      </section>
    <% end %>
    <details class="promise-method">
      <summary>How we score the record</summary>
      <dl>
        <dt>One point</dt><dd>The member delivered or materially advanced what they proposed. A vote on the same issue earns credit only if it advanced that goal. Bringing a measure to a vote can fulfill a promise to introduce it.</dd>
        <dt>Minus one point</dt><dd>The member took a documented action against that campaign position. Each position can lose one point.</dd>
        <dt>Zero points</dt><dd>An unsuccessful attempt earns zero toward a promised outcome. A missed opportunity is a failure to act at a specific opening documented in the record. An evidence gap also earns zero.</dd>
        <% if pace.rating %>
          <dt>Term pace</dt><dd>We compare the net score with the share of the term elapsed. Green meets an even pace, amber trails by up to 10 percentage points, and red trails by more. At term end, any outstanding promise leaves the record short. Individual projects can have different deadlines.</dd>
        <% end %>
      </dl>
      <p>The score is results minus reversals, divided by all tracked positions. It can fall below zero. Alternatives offered together count as one position. Findings reviewed <%= report.generated_at.to_date.to_fs(:long) %>.<% if pace.rating %> Term runs <%= report.term_started_on.to_fs(:long) %> – <%= pace.ends_on.to_fs(:long) %>.<% end %></p>
    </details>
    <%= link_to "Full campaign record", campaign_member_path(@member, anchor: "campaign-record"), class: "profile-campaign-link" %>
  </section>
<% else %>
  <%= link_to "Full campaign record", campaign_member_path(@member, anchor: "campaign-record"), class: "profile-campaign-link" %>
<% end %>
