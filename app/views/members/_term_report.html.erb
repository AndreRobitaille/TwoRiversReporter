<% emphasis = ResidentContent::CampaignPlatform::EDITION.dig("members", @member.name, "story_emphasis") || [] %>
<% campaign, in_office = report.sentences.partition do |sentence|
     sources = sentence.fetch("sources")
     sources.any? && sources.all? { |source| @campaign_source_urls.include?(source.fetch("url")) }
   end %>
<% if score.total.positive? %>
  <section class="promise-report" aria-label="Campaign promise results and term pace" data-pace="<%= pace.rating(score) %>">
    <p class="member-term-copy score-lead"><strong><%= pluralize(score.met, "documented result") %></strong>
      across <%= pluralize(score.total, "assessed position") %>.<% if score.partial_count.positive? %> <%= pluralize(score.partial_count, "position") %> with partial credit.<% end %> <%= score.open_count %> open.
      <% if pace.elapsed %><%= pace.elapsed_percent %>% of the term has elapsed.<% end %>
    </p>
    <div class="promise-meter">
      <span class="member-term-score"><strong><%= score.score %>/100</strong> promise score</span>
      <meter min="0" max="100" value="<%= score.score %>" aria-label="Promise score out of 100"><%= score.score %>/100</meter>
    </div>
    <% if pace.rating(score) %>
      <div class="promise-meter term-clock">
        <span><%= pace.label(score) %> · <%= pluralize(pace.days_left, "day") %> left</span>
        <meter min="0" max="100" value="<%= pace.elapsed_percent %>" aria-label="Council term elapsed"><%= pace.elapsed_percent %>%</meter>
      </div>
    <% end %>
    <% deductions = promise_deductions(groups, score) %>
    <% if score.net_points.negative? %><p class="member-term-copy">Deductions exceed credit for results so far. The score stops at zero.</p><% end %>
    <% if deductions.any? %>
      <ul class="score-deductions" aria-label="Point deductions">
        <% deductions.each do |points, caption, target| %>
          <li><%= link_to target, data: { turbo: false } do %>
            <strong><%= CouncilProfiles::PromiseFollowThrough.format_points(points) %></strong><span><%= caption %></span>
          <% end %></li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>

<% if (pending = groups["pending_review"]) %>
  <p class="term-assessment-coverage"><%= score.total %> of <%= report.promise_assessments.size %> campaign positions assessed. <%= link_to "#{pluralize(pending.size, "position")} awaiting review", "#promise-group-pending_review", data: { turbo: false } %>.</p>
<% end %>

<div class="term-narrative">
  <dl class="term-digest">
    <% { "Ran on" => campaign, "In office" => in_office }.each do |label, passages| %>
      <% next if passages.empty? %>
      <div>
        <dt><%= label %></dt>
        <dd>
          <% passages.each do |passage| %>
            <p class="member-term-copy"><%= highlight(h(passage.fetch("text")), emphasis, highlighter: '<strong>\1</strong>') %></p>
          <% end %>
        </dd>
      </div>
    <% end %>
    <% if groups["missed"] %>
      <div class="term-misses">
        <dt>Missed <%= "opportunity".pluralize(groups["missed"].size) %></dt>
        <dd>
          <ul>
            <% groups.fetch("missed").each do |item, _index| %>
              <li><%= item["profile_subject"] || item["heading"].presence || item.fetch("label") %></li>
            <% end %>
          </ul>
        </dd>
      </div>
    <% end %>
  </dl>
  <details class="member-term-sources story-notes">
    <summary>Sources for the term overview</summary>
    <ol>
      <% report.sentences.each do |sentence| %>
        <li>
          <p><%= sentence.fetch("text").truncate(85, separator: " ") %></p>
          <ul>
            <% sentence.fetch("sources").each do |source| %>
              <li><%= link_to source.fetch("label"), source.fetch("url") %></li>
            <% end %>
          </ul>
        </li>
      <% end %>
      <% groups.fetch("missed", []).each do |item, _index| %>
        <li>
          <p><%= item["profile_subject"] || item["heading"].presence || item.fetch("label") %></p>
          <ul>
            <% item.fetch("sources").reject { |source| @campaign_source_urls.include?(source.fetch("url")) }.each do |source| %>
              <li><%= profile_source_link source.fetch("label"), source.fetch("url"), finding: item["heading"] %></li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ol>
  </details>
</div>
