<div class="member-campaign-position" <%= tag.attributes(data: { campaign_actions_for: statement.id }) if actions.any? %>>
  <p><%= statement.data.fetch("summary") %></p>
  <% campaign_qualifications(statement).each do |qualification| %>
    <p class="member-campaign-qualification"><%= qualification %></p>
  <% end %>
  <% if actions.any? %>
    <h4 class="member-campaign-activity-heading"><%= actions.any? { |action| action[:kind] } ? "What happened next" : "On the Council" %></h4>
    <% actions.first(2).each do |action| %>
      <%= render(action[:vote] ? "campaign_action" : "campaign_issue_evidence", action: action) %>
    <% end %>
    <% if actions.size > 2 %>
      <details class="member-campaign-context">
        <summary><%= pluralize(actions.size - 2, actions.any? { |action| action[:kind] } ? "more record" : "more decision") %></summary>
        <% actions.drop(2).each do |action| %>
          <%= render(action[:vote] ? "campaign_action" : "campaign_issue_evidence", action: action) %>
        <% end %>
      </details>
    <% end %>
    <details class="member-campaign-context member-campaign-supporting">
      <summary>Supporting details</summary>
      <% actions.each do |action| %>
        <%= render(action[:vote] ? "campaign_action_evidence" : "campaign_issue_evidence_source", action: action) %>
      <% end %>
    </details>
  <% end %>
</div>
