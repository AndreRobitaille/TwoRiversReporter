<%# Unified meeting card with date slab. Locals: meeting %>
<% is_council = council_meeting?(meeting) %>
<% headline = best_headline(meeting) %>
<% approved_topics = approved_substantive_topics(meeting)
     .sort_by { |t| [-(t.resident_impact_score || 0), -(t.last_activity_at&.to_i || 0)] } %>
<% is_upcoming = meeting.starts_at > Time.current %>
<% generated_image = @meeting_generated_images&.[](meeting.id) %>
<% has_image = generated_image&.file&.attached? %>
<%= link_to meeting_path(meeting), class: (has_image ? "meetings-card meetings-card--with-image" : "meetings-card") do %>
  <div class="meetings-date-slab <%= 'meetings-date-slab--council' if is_council %>">
    <span class="meetings-date-month"><%= meeting.starts_at.strftime("%b") %></span>
    <span class="meetings-date-day"><%= meeting.starts_at.strftime("%-d") %></span>
    <span class="meetings-date-dow"><%= meeting.starts_at.strftime("%a") %></span>
  </div>
  <div class="meetings-card-body">
    <% if has_image %>
      <div class="meetings-card-media">
        <% dimensions = generated_image_dimensions(size: :standard) %>
        <%= image_tag generated_image_proxy_path(generated_image, size: :standard),
          alt: "Illustration for #{meeting.body_name.sub(/ Meeting$/, '')}",
          class: "meetings-card-image",
          loading: "lazy",
          decoding: "async",
          width: dimensions[:width],
          height: dimensions[:height] %>
      </div>
    <% end %>
    <div class="meetings-card-top">
      <span class="meetings-card-name"><%= meeting.body_name.sub(/ Meeting$/, "") %></span>
      <% if is_upcoming %>
        <span class="meetings-card-time"><%= meeting.starts_at.strftime("%-l:%M %p") %></span>
      <% end %>
    </div>
    <% if headline %>
      <p class="meetings-card-headline"><%= teaser(headline, chars: 90, fade: :inline) %></p>
      <%# The card itself is already an <a> — nesting the sign-in prompt in
          another <a> would be invalid HTML that browsers unnest, breaking
          the layout. This is a styled span, not a link; the visitor lands
          on the gated meeting page via the card's own click target either
          way. %>
      <% if gated_for_visitor? %>
        <span class="meetings-card-signin-note">Sign in to read this meeting &rarr;</span>
      <% end %>
    <% end %>
    <% if approved_topics.any? %>
      <div class="meetings-topic-pills">
        <% approved_topics.first(4).each do |topic| %>
          <span class="meetings-topic-pill"><%= topic.name %></span>
        <% end %>
        <% if approved_topics.size > 4 %>
          <span class="meetings-topic-pill meetings-topic-pill--more">+<%= approved_topics.size - 4 %> more</span>
        <% end %>
      </div>
    <% elsif is_upcoming && !headline && meeting.document_status == :none %>
      <span class="meetings-card-note">Agenda not yet posted</span>
    <% end %>
  </div>
<% end %>
