<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Crawler access diagnostic</title>
  </head>
  <body>
    <h1>Crawler access diagnostic</h1>
    <p>This page contains harmless synthetic test content.</p>
    <% if @probe.fetch(:mode) == "public" || !gated_for_visitor? %>
      <p>Verification code: <strong><%= @probe.fetch(:code) %></strong></p>
    <% else %>
      <p>Verification code withheld. Sign in to keep reading.</p>
    <% end %>
  </body>
</html>
