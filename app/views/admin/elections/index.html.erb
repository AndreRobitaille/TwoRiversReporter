<% content_for(:title) { "Spring #{@workspace.year} Council election — Admin" } %>
<% year = @workspace.year %>
<% date = @workspace.date %>
<% attention, saved = election_work_items(@workspace).partition { |item| item[:attention] } %>
<% filing_edition = @workspace.filing_edition %>
<% candidate_list_needed = @workspace.candidate_list_needed? %>
<% candidate_list_due = @workspace.candidate_list_due? %>
<% candidate_list_title = "#{year} Candidates" %>
<% prior_sources = @workspace.prior_sources %>
<% prior = prior_sources.find { |source| !source.forum? && Campaigns::ElectionBackfill.htr?(source) } %>
<% clerk_url = ResidentContent::CouncilElection::CLERK_URL %>
<div class="election-workspace" data-controller="election-drafts" data-user="<%= Current.user.id %>">
  <header class="election-board-heading election-season-banner">
    <h1>Spring <%= year %> Council election</h1>
    <div class="election-board-context">
      <%= form_with url: admin_elections_path, method: :get, class: "election-year-picker",
            data: { controller: "election-year", action: "pageshow@window->election-year#restoreSelection", turbo: false } do |form| %>
        <%= form.label :year, "Change election" %>
        <span class="sr-only" id="election-year-help">Choosing a year opens its page immediately.</span>
        <% choices = @workspace.years.map { |option| [option == @workspace.current_year ? "#{option} · Current season" : option, option] } %>
        <%= form.select :year, options_for_select(choices, year), {}, class: "form-select",
              aria: { describedby: "election-year-help" }, data: { action: "change->election-year#navigate" } %>
      <% end %>
      <time datetime="<%= date.iso8601 %>"><%= date.strftime("%B %-d, %Y") %></time>
    </div>
  </header>

  <%= tag.p(notice, class: "flash flash--success", role: "status") if notice %>

  <% if attention.any? || saved.any? %>
    <p class="election-source-guidance"><strong>Process each source when it’s ready.</strong> Checked statements from an article or forum can appear on Council member records on their own.</p>
  <% end %>

  <div class="election-board-grid">
    <% task_heading = @workspace.current? ? "election-needs-you" : "election-backfill-tasks" %>
    <section class="election-panel" aria-labelledby="<%= task_heading %>">
      <header class="election-panel-heading <%= (attention.any? || candidate_list_due) ? "election-panel-heading--attention" : "election-panel-heading--clear" %>">
        <h2 id="<%= task_heading %>"><%= @workspace.current? ? "Needs you" : "Backfill tasks" %></h2>
      </header>
      <% if candidate_list_needed %>
        <div class="election-panel-row" id="candidate-list-task">
          <h3><%= candidate_list_title %></h3>
          <% unless candidate_list_due %><p>Add the list when the names are available.</p><% end %>
          <%= link_to "Add candidates", new_admin_election_candidate_list_path(year: year), class: "election-action" %>
        </div>
      <% end %>
      <% if attention.any? %>
        <ul class="election-task-list"><%= render partial: "work_item", collection: attention, as: :item, locals: { date: date } %></ul>
      <% elsif !candidate_list_needed %>
        <div class="election-panel-row"><h3><%= @workspace.current? ? "Nothing needed today" : "No source intake tasks" %></h3>
        </div>
      <% end %>
    </section>

    <section class="election-panel" aria-labelledby="election-done">
      <header class="election-panel-heading"><h2 id="election-done">Done and waiting</h2></header>
      <% if filing_edition %>
        <div class="election-panel-row">
          <p class="election-task-status">Terms identified</p>
          <h3>Terms ending this spring</h3>
          <p><%= filing_edition.terms_ending.keys.to_sentence %>.</p>
        </div>
        <% unless candidate_list_needed %>
          <div class="election-panel-row" id="candidate-list">
            <h3><%= candidate_list_title %></h3>
            <% if filing_edition.candidates.any? %>
              <p><%= filing_edition.candidates.keys.to_sentence %></p>
              <% if (list = filing_edition.candidate_list) %>
                <% if list.source_url %><p><%= link_to "Candidate list source", list.source_url %></p><% end %>
                <%= link_to "Edit candidates", edit_admin_election_candidate_list_path(year: year, id: list), class: "election-action" %>
              <% end %>
            <% else %>
              <%= link_to "Add candidates", new_admin_election_candidate_list_path(year: year), class: "election-action" %>
            <% end %>
          </div>
        <% end %>
      <% elsif @workspace.current? && date >= Date.current %>
        <div class="election-panel-row">
          <p class="election-task-status">Awaiting the Clerk’s schedule</p>
          <h3>Candidate filing</h3>
          <p><%= link_to "City Clerk election information", clerk_url, target: "_blank", rel: "noopener" %></p>
        </div>
      <% end %>
      <% @workspace.edition.fetch("announced_forums", []).each do |forum| %>
        <div class="election-panel-row">
          <p class="election-task-status">Watching for the recording</p>
          <h3><%= forum.organizer %> forum · <%= forum.held_on.strftime("%B %-d") %></h3>
          <%= link_to "City announcement", forum.announcement_url %>
        </div>
      <% end %>
      <% if prior %>
        <div class="election-panel-row">
          <p class="election-task-status">Prior campaign evidence</p>
          <h3><%= prior.election_on.year %> HTR questionnaire</h3>
          <p>Answers from the election that started the terms ending this spring.</p>
          <% if prior_sources.all? { |source| source.current_version.extraction&.status == "completed" } %>
            <p>Analysis complete for <%= pluralize(prior_sources.count(&:forum?), "forum") %> and the questionnaire.</p>
          <% end %>
          <div class="questionnaire-sidebar-links">
            <%= link_to "View #{prior.election_on.year} questionnaire", admin_campaign_source_path(prior, from_year: year) %>
            <%= link_to "View #{prior.election_on.year} election sources", admin_elections_path(year: prior.election_on.year) %>
          </div>
        </div>
      <% end %>
      <% if saved.any? %>
        <ul class="election-task-list"><%= render partial: "work_item", collection: saved, as: :item, locals: { date: date } %></ul>
      <% end %>
      <% if @workspace.edition["term_members"] %>
        <div class="election-panel-row">
          <p class="election-task-status">Election outcome on file</p>
          <h3>Elected to the Council</h3>
          <p><%= @workspace.edition.fetch("term_members").to_sentence %>.</p>
        </div>
      <% end %>
    </section>
  </div>
  <section class="election-source-tools" aria-labelledby="source-tools-heading">
    <header class="source-tools-heading">
      <h2 id="source-tools-heading">Source tools</h2>
      <%= link_to "All campaign sources", admin_campaign_sources_path %>
    </header>
    <% can_search = filing_edition || @workspace.edition.present? %>
    <div class="source-tools-groups">
      <div class="source-tools-group">
        <h3><%= render "source_icon", kind: "forum" %> Voter forums</h3>
        <div class="source-tools-actions">
          <% if can_search %>
            <%= button_to "Find voter forums", admin_election_find_forums_path(year: year), class: "election-action" %>
          <% end %>
          <%= link_to "Label another forum", desk_admin_campaign_forum_path(year: year) %>
        </div>
      </div>
      <div class="source-tools-group">
        <h3><%= render "source_icon", kind: "article" %> News articles</h3>
        <div class="source-tools-actions">
          <% if can_search %>
            <%= button_to "Find HTR questionnaire", admin_election_find_htr_path(year: year), class: "election-action" %>
          <% end %>
          <%= link_to "Add another article", new_admin_campaign_source_path(year: year) %>
        </div>
      </div>
    </div>
    <details class="source-tools-files">
      <summary>Speaker project files</summary>
      <nav aria-label="Speaker project files">
        <%= link_to "Resume a speaker project", desk_admin_campaign_forum_path(year: year, files: 1) %>
        <%= link_to "Import a reviewed transcript", new_admin_campaign_forum_path %>
      </nav>
    </details>
  </section>
</div>
