<% content_for(:title) { "#{@source.title} - Campaign source - Admin" } %>
<% if flash[:alert] %><p class="flash flash--danger" role="alert"><%= flash[:alert] %></p><% end %>
<% if flash[:notice] %>
  <div class="flash flash--success" role="status"><%= flash[:notice] %></div>
<% end %>
<% if @questionnaire && params[:view] != "processing" %>
  <%= render "questionnaire_record" %>
<% else %>
  <% if @questionnaire %>
    <%= link_to "← Questionnaire", admin_campaign_source_path(@source, version: params[:version], from_year: params[:from_year]), class: "election-back" %>
  <% else %>
    <%= link_to "← #{@version.election_on.year} election", admin_elections_path(year: @version.election_on.year), class: "speaker-desk__back" %>
  <% end %>
  <div class="page-header">
    <h1 class="page-title"><%= @version.title %></h1>
    <p class="page-subtitle"><%= params[:view] == "processing" ? "Source processing and issue matching." : @version.publisher %></p>
    <% if @source.forum? %>
      <%= link_to "Edit speaker labels", desk_admin_campaign_forum_path(source_id: @source), class: "btn btn--primary" %>
      <%= link_to "Replace transcript", new_admin_campaign_forum_path(source_id: @source.id), class: "btn btn--secondary" %>
    <% else %>
      <%= link_to "Edit article", edit_admin_campaign_source_path(@source), class: "btn btn--primary" %>
    <% end %>
  </div>
  <% if @version == @source.current_version && params[:view] != "processing" && @extraction&.status != "completed" %>
    <div class="election-workspace"><%= render "analysis_status", source: @source, version: @version,
      progress: Admin::QuestionnaireProgress.new(@version), saved_label: (@version.forum? ? "Speaker labels saved" : "Answers saved") %></div>
  <% end %>
  <p><%= link_to "All campaign sources", admin_campaign_sources_path %>
    <% if params[:view] != "processing" %>
      · <%= link_to "Processing details", admin_campaign_source_path(@source, view: "processing", version: params[:version]) %>
    <% end %>
  </p>
  <% if @version != @source.current_version %>
    <p class="flash">Viewing an earlier version. <%= link_to "View current version", admin_campaign_source_path(@source) %></p>
  <% end %>
  <%= render layout: "record_details" do %>
    <div class="card election-source-text" id="source-text">
      <h2 class="card-title"><%= @version.forum? ? "Prepared transcript" : "Article text" %></h2>
      <div data-campaign-source-text class="detail-value detail-value--preserve"><%= @version.body %></div>
    </div>
  <% end %>
<% end %>
