<div class="election-workspace">
  <%= link_to "← #{@return_year} election", admin_elections_path(year: @return_year), class: "election-back" %>
  <header class="election-board-heading">
    <h1><%= @year %> <%= @version.publisher %> questionnaire</h1>
    <p><%= @version.publisher %> · <%= @version.published_on&.strftime("%B %-d, %Y") || "Publication date unknown" %></p>
  </header>
  <% if @version != @source.current_version %>
    <p class="flash">Viewing an earlier version. <%= link_to "View current answers", admin_campaign_source_path(@source, from_year: params[:from_year]) %></p>
  <% end %>
  <%= render "analysis_status", source: @source, version: @version, progress: @progress, saved_label: "Answers saved" %>
  <div class="election-board-grid questionnaire-record">
    <aside class="election-panel questionnaire-sidebar" aria-labelledby="questionnaire-source">
      <header class="election-panel-heading"><h2 id="questionnaire-source">Source and history</h2></header>
      <div class="election-panel-row">
        <h3><%= @version.title %></h3>
        <p><%= @version.election_on.strftime("%B %-d, %Y") %> election · <%= CampaignSource::COVERAGES.fetch(@version.coverage) %></p>
        <% if @version.coverage_notes.present? %><p><%= @version.coverage_notes %></p><% end %>
        <div class="questionnaire-sidebar-links">
          <%= link_to @questionnaire.fetch("link_label", "Open published article"), @version.source_url, target: "_blank", rel: "noopener" %>
          <%= link_to "Read saved answers", "#source-text" %>
          <% if @version == @source.current_version %>
            <%= link_to "Edit answers", edit_admin_campaign_source_path(@source, from_year: params[:from_year]) %>
            <%= link_to "Edit article details", edit_admin_campaign_source_path(@source, details: 1) %>
          <% end %>
        </div>
      </div>
      <% if Campaigns::ElectionBackfill.htr?(@version) %>
        <div class="election-panel-row"><h3>Candidate photos <small>Optional</small></h3>
          <p>Any photos are in the original article. This record contains the answers.</p>
        </div>
      <% end %>
      <div class="election-panel-row">
        <h3>Analysis details</h3>
        <p><%= link_to "Processing and issue matching", admin_campaign_source_path(@source, version: params[:version], view: "processing", from_year: params[:from_year]) %></p>
      </div>
      <div class="election-panel-row">
        <h3>Saved versions</h3>
        <ul class="questionnaire-version-list">
          <% @versions.each do |version| %>
            <li>
              <% label = version.created_at.in_time_zone.strftime("%b %-d, %Y at %-l:%M %p") %>
              <% if version == @version %><strong><%= label %></strong> · Viewing
              <% else %><%= link_to label, admin_campaign_source_path(@source, version: version.id, from_year: params[:from_year]) %><% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </aside>
    <div class="questionnaire-record-main">
      <% if @progress.matched.any? || @progress.unresolved.any? || @progress.unlinked.any? || @progress.extraction&.data&.fetch("coverage_gaps", [])&.any? %>
        <section class="election-panel questionnaire-progress" aria-labelledby="questionnaire-findings">
          <header class="election-panel-heading"><h2 id="questionnaire-findings">Statements from the questionnaire</h2></header>
          <% @progress.unresolved.group_by { |statement| [statement.data["source_name"], statement.exception] }.each do |(name, reason), statements| %>
            <section class="questionnaire-review election-panel-row">
              <p class="election-task-status">Needs review</p>
              <h3><%= name.presence || "Unidentified speaker" %></h3>
              <p><%= questionnaire_review_reason(reason) %></p>
              <ul class="questionnaire-statement-list">
                <%= render partial: "questionnaire_statement", collection: statements, as: :statement %>
              </ul>
            </section>
          <% end %>
          <% @progress.matched.group_by(&:member).each do |member, statements| %>
            <section class="election-panel-row">
              <p class="election-task-status">Matched to Council record</p>
              <h3><%= link_to member.name, campaign_member_path(member, anchor: "campaign-record") %></h3>
              <ul class="questionnaire-statement-list">
                <%= render partial: "questionnaire_statement", collection: statements, as: :statement %>
              </ul>
            </section>
          <% end %>
          <% @progress.unlinked.group_by { |statement| statement.data["source_name"] }.each do |name, statements| %>
            <section class="election-panel-row">
              <p class="election-task-status">Kept with the questionnaire</p>
              <h3><%= name %></h3>
              <p>These answers are part of the campaign source and are separate from the Council member records.</p>
              <ul class="questionnaire-statement-list">
                <%= render partial: "questionnaire_statement", collection: statements, as: :statement %>
              </ul>
            </section>
          <% end %>
          <% if @progress.extraction&.status == "completed" %>
            <% gaps = @progress.extraction.data.fetch("coverage_gaps", []) %>
            <% if gaps.any? %>
              <div class="election-panel-row"><h3>Coverage gaps</h3><ul><% gaps.each do |gap| %><li><%= gap["description"] %></li><% end %></ul></div>
            <% end %>
          <% end %>
        </section>
      <% end %>
      <section class="election-panel election-source-text questionnaire-saved-answers" id="source-text">
        <header class="election-panel-heading"><h2>Saved Council answers</h2></header>
        <div data-campaign-source-text class="election-panel-row detail-value--preserve"><%= @version.body %></div>
      </section>
    </div>
  </div>
</div>
