<% content_for(:title) { "Campaign sources - Admin" } %>
<div class="page-header">
  <div>
    <div>
      <h1 class="page-title">Campaign sources</h1>
      <p class="page-subtitle">Keep articles and prepared forums for every candidate.</p>
    </div>
    <%= link_to "Add article", new_admin_campaign_source_path, class: "btn btn--primary" %>
    <%= link_to "Import forum", new_admin_campaign_forum_path, class: "btn btn--secondary" %>
  </div>
</div>
<p><%= link_to "Back to members", admin_members_path %></p>
<% if @sources.empty? %>
  <div class="empty-state">No campaign sources have been saved.</div>
<% else %>
  <div class="table-wrapper">
    <table>
      <thead><tr><th>Source</th><th>Election</th><th>Coverage</th></tr></thead>
      <tbody>
        <% @sources.each do |source| %>
          <tr>
            <td><%= link_to source.title, admin_campaign_source_path(source) %></td>
            <td><%= source.election_on.strftime("%b %-d, %Y") %></td>
            <td><%= CampaignSource::COVERAGES.fetch(source.coverage) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
