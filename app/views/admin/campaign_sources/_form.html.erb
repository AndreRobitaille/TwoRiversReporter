<%= form_with model: [:admin, source] do |form| %>
  <% if source.errors.any? %>
    <div class="flash flash--danger" role="alert"><%= source.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="form-group">
    <%= form.label :title, "Article title", class: "form-label" %>
    <%= form.text_field :title, class: "form-input", required: true %>
  </div>
  <div class="form-group">
    <%= form.label :source_url, "Publisher link", class: "form-label" %>
    <%= form.url_field :source_url, class: "form-input", required: true %>
  </div>
  <div class="form-group">
    <%= form.label :publisher, class: "form-label" %>
    <%= form.text_field :publisher, class: "form-input", required: true %>
  </div>
  <div class="form-group">
    <%= form.label :published_on, "Publication date (if known)", class: "form-label" %>
    <%= form.date_field :published_on, class: "form-input" %>
  </div>
  <div class="form-group">
    <%= form.label :election_on, "Election date", class: "form-label" %>
    <%= form.date_field :election_on, class: "form-input", required: true %>
  </div>
  <div class="form-group">
    <%= form.label :coverage, "Text included", class: "form-label" %>
    <%= form.select :coverage, CampaignSource::COVERAGES.except("full_transcript").map { |value, label| [label, value] }, {}, class: "form-select" %>
  </div>
  <div class="form-group">
    <%= form.label :coverage_notes, "Missing material or other context", class: "form-label" %>
    <%= form.text_area :coverage_notes, rows: 2, class: "form-textarea" %>
  </div>
  <div class="form-group">
    <%= form.label :body, "Article text", class: "form-label" %>
    <%= form.text_area :body, rows: 18, class: "form-textarea", required: true %>
    <p class="text-sm text-muted">Paste text you can use, including question headings and candidate names. It stays private to admins; saving does not run AI or publish the article.</p>
  </div>
  <%= form.submit "Save article", class: "btn btn--primary" %>
  <%= link_to "Cancel", admin_campaign_sources_path, class: "btn btn--secondary" %>
<% end %>
