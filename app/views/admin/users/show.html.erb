<div class="page-header">
  <h1 class="page-title"><%= @user.email_address %></h1>
</div>

<div class="flex gap-2 mb-4">
  <%= button_to "Approve application", approve_admin_user_path(@user), method: :patch, class: "btn btn--primary" %>
  <%= button_to "Reject application", reject_admin_user_path(@user), method: :patch, params: { rejection_reason: "" }, class: "btn btn--secondary" %>
  <%= button_to(@user.admin? ? "Remove admin" : "Make admin", toggle_admin_admin_user_path(@user), method: :patch, class: "btn btn--secondary") %>
  <%= button_to "Disable user", disable_admin_user_path(@user), method: :patch, class: "btn btn--secondary" %>
</div>

<h2>Applications</h2>
<ul>
  <% @applications.each do |application| %>
    <li><%= application.status %> - <%= application.first_name %> <%= application.last_name %></li>
  <% end %>
</ul>

<h2>Sessions</h2>
<ul>
  <% @sessions.each do |session| %>
    <li>
      <%= session.id %>
      <%= button_to "Revoke", revoke_session_admin_user_path(@user, session_id: session.id), method: :delete %>
    </li>
  <% end %>
</ul>
