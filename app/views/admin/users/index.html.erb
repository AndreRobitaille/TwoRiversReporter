<% if flash[:notice] %>
  <div class="flash flash--success"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div class="flash flash--danger"><%= flash[:alert] %></div>
<% end %>

<div class="page-header">
  <h1 class="page-title">Account management</h1>
  <p class="page-subtitle">Review access requests and manage approved or denied accounts</p>
</div>

<div class="flex gap-2 mb-6">
  <%= link_to "New admin user", new_user_path, class: "btn btn--primary" %>
  <%= link_to "Back", admin_root_path, class: "btn btn--secondary" %>
</div>

<div class="section-header">
  <%= render "shared/atom_marker", theme: "silo" %>
  <span class="section-header__label">Needs attention</span>
  <span class="badge badge--warning"><%= @users_needing_action.size %></span>
  <div class="section-header__line"></div>
</div>

<% if @users_needing_action.any? %>
  <div class="table-wrapper mb-6">
    <table class="adm-table">
      <thead>
        <tr>
          <th>Email</th>
          <th>Account</th>
          <th>State</th>
          <th>Passkeys</th>
          <th>Application</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @users_needing_action.each do |user| %>
          <%= render "account_row", user: user, application: @latest_applications[user] %>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state mb-6">No accounts need a decision.</div>
<% end %>

<div class="section-header">
  <%= render "shared/atom_marker", theme: "silo" %>
  <span class="section-header__label">Denied</span>
  <span class="badge badge--danger"><%= @denied_users.size %></span>
  <div class="section-header__line"></div>
</div>

<% if @denied_users.any? %>
  <div class="table-wrapper mb-6">
    <table class="adm-table">
      <thead>
        <tr>
          <th>Email</th>
          <th>Account</th>
          <th>State</th>
          <th>Passkeys</th>
          <th>Application</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @denied_users.each do |user| %>
          <%= render "account_row", user: user, application: @latest_applications[user] %>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state mb-6">No accounts have been denied.</div>
<% end %>

<div class="section-header">
  <%= render "shared/atom_marker", theme: "silo" %>
  <span class="section-header__label">Approved</span>
  <span class="badge badge--success"><%= @approved_users.size %></span>
  <div class="section-header__line"></div>
</div>

<% if @approved_users.any? %>
  <div class="table-wrapper">
    <table class="adm-table">
      <thead>
        <tr>
          <th>Email</th>
          <th>Account</th>
          <th>State</th>
          <th>Passkeys</th>
          <th>Application</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @approved_users.each do |user| %>
          <%= render "account_row", user: user, application: @latest_applications[user] %>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state">No accounts have been approved.</div>
<% end %>
