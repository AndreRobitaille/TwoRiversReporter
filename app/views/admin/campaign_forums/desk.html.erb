<% content_for(:title) { "Speaker desk — Elections" } %>
<% content_for(:head) { tag.meta(name: "turbo-cache-control", content: "no-cache") } %>
<% content_for(:editor_workspace, "true") %>
<% ready = @replacement || Campaigns::ElectionBackfill.caption_path(@lead) %>
<div class="speaker-desk" data-controller="forum-desk" data-names="<%= ["Moderator", *@edition.fetch("candidates", []), "Audience member"].to_json %>"
     data-user="<%= Current.user.id %>" data-preview="<%= captions_admin_campaign_forum_path %>"
     data-version="<%= @replacement&.current_version&.id %>" data-moderator="<%= @replacement&.prepared_transcript&.fetch("gaps_are_moderator", false) %>"
     data-project="<%= desk_admin_campaign_forum_path(source_id: @replacement, format: :json) if @replacement %>"
     data-recording="<%= recording_admin_campaign_forum_path(year: @year, lead: params[:lead]) if !@replacement && ready %>">
  <header class="speaker-desk__header">
    <div>
      <%= link_to "← Elections#{ " · #{@year}" if @year.present? }", admin_elections_path(year: @year), class: "speaker-desk__back" %>
      <h1>Speaker desk</h1>
    </div>
    <div class="desk-actions">
      <button type="button" class="desk-button" id="manage-files" aria-controls="desk-files">Open files</button>
      <button type="button" class="desk-button" id="save" disabled>Download backup</button>
      <button type="button" class="desk-button desk-button--primary" id="review-open" disabled>Review &amp; save</button>
    </div>
  </header>
  <div id="desk-files" class="desk-panel desk-files" <%= "hidden" if ready && params[:files].blank? %>>
    <div><label for="caption-file">Open SRT or VTT captions</label>
      <input type="file" id="caption-file" accept=".vtt,.srt,text/vtt,text/plain"></div>
    <div><label for="project-file">Resume a saved speaker project</label>
      <input type="file" id="project-file" accept=".json,application/json">
      <p class="desk-file-help">Each download makes a new backup file. Open it here to continue on another computer.</p></div>
  </div>
  <p id="notice" role="status" <%= "hidden" unless ready %>>Opening your transcript…</p>
  <div id="work" class="desk-grid" hidden>
    <section class="desk-paper" aria-label="Transcript workspace">
      <div class="desk-paper__toolbar">
        <% if @recordings.size > 1 %>
          <label class="desk-switch">Recording
            <select id="recording-switch">
              <option value="">Choose a recording</option>
              <% @recordings.each do |key, item| %>
                <% target = @saved_ids[item["url"]] ? desk_admin_campaign_forum_path(source_id: @saved_ids[item["url"]]) : desk_admin_campaign_forum_path(year: @year, lead: key) %>
                <%= tag.option item.fetch("short_title"), value: target, data: { url: item["url"] }, selected: item["url"] == @lead["url"] %>
              <% end %>
            </select>
          </label>
        <% end %>
        <a id="watch" hidden target="_blank" rel="noopener noreferrer">Watch recording ↗</a>
        <div class="desk-actions"><button id="undo" type="button" class="desk-button" disabled>Undo</button>
          <button id="redo" type="button" class="desk-button" disabled>Redo</button></div>
      </div>
      <div class="desk-paper__heading">
        <div><h2 id="reading-title"><%= @lead["title"] %></h2>
          <p><%= @lead["caption_note"] || "Click a timestamp to hear that part of the recording." %></p></div>
        <div class="desk-coverage"><strong id="progress">0%</strong><span id="progress-detail">words labeled</span></div>
      </div>
      <progress id="progress-bar" max="100" value="0" aria-label="Transcript labeled"></progress>
      <div class="desk-paper__instructions"><span class="desk-pointer-hint">Highlight the words one person says, then choose their name.</span><span class="desk-touch-hint">Press and hold a word. Drag the handles to select the passage.</span>
        <button type="button" id="next" class="desk-button">Next unlabeled passage</button></div>
      <div class="desk-mobile-speaker">
        <label for="quick-speaker">Who is speaking?</label>
        <select id="quick-speaker" disabled></select>
      </div>
      <article id="transcript" class="forum-desk__transcript" aria-label="Selectable transcript" tabindex="0"></article>
    </section>
    <aside class="desk-tools" aria-label="Speaker controls">
      <div class="desk-panel">
        <h2>Who is speaking?</h2>
        <p id="selection-status" aria-live="polite">Highlight a passage in the transcript.</p>
        <div id="speakers"></div>
        <button type="button" id="clear" class="desk-button" disabled>Remove label</button>
        <p class="desk-hint">Choose another name to correct a label. You can also press the number beside a name.</p>
      </div>
      <p id="save-status" role="status"></p>
      <details class="desk-disclosure"><summary>Labeled passages <span id="label-count"></span></summary><div id="label-list"></div></details>
      <details class="desk-disclosure"><summary>Edit speaker names</summary>
        <div id="name-fields"></div>
        <label for="new-speaker">Additional speaker</label><input id="new-speaker" class="form-input" maxlength="150">
        <button id="add-speaker" type="button" class="desk-button">Add speaker</button>
      </details>
      <button id="export" type="button" class="desk-button">Export labeled text</button>
    </aside>
  </div>
  <dialog id="review-dialog" class="desk-review" aria-labelledby="review-title">
    <h2 id="review-title">Review &amp; save</h2>
    <p id="review-summary"></p>
    <%= render "import", desk: true %>
  </dialog>
</div>
