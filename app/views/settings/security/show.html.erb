<% content_for(:title) { "Account — Security" } %>
<% content_for(:description) { "Manage the passkeys attached to your account." } %>

<%= render "settings/header" %>
<%= render "settings/tabs", current: :security %>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Passkeys</h2>
    <p class="card-subtitle">
      Passkeys let you sign in without a password. They stay on your devices and
      use whatever unlocks them — a fingerprint, a face, or a PIN.
    </p>
  </div>

  <section
    data-controller="passkey"
    data-passkey-registration-options-url-value="<%= registration_options_passkeys_path(format: :json) %>"
    data-passkey-registration-url-value="<%= registration_passkeys_path(format: :json) %>"
    data-passkey-authentication-options-url-value="<%= authentication_options_passkeys_path(format: :json) %>"
    data-passkey-authentication-url-value="<%= authentication_passkeys_path(format: :json) %>"
  >
    <% if @passkey_management_unlocked %>
      <button type="button" class="btn btn--primary" data-action="passkey#register" data-passkey-target="trigger">
        Add a passkey
      </button>
    <% else %>
      <p class="auth-dek">
        Confirm it's you before adding or removing a passkey.
      </p>
      <%= link_to "Confirm it's you", new_reauthentication_path, class: "btn btn--primary" %>
    <% end %>

    <p class="auth-status" data-passkey-target="status" aria-live="polite" role="status"></p>

    <% if @passkey_credentials.any? %>
      <ul class="passkey-list">
        <% @passkey_credentials.each do |credential| %>
          <li class="passkey-item">
            <div class="passkey-item__body">
              <p class="passkey-item__name"><%= credential.nickname.presence || "Unnamed passkey" %></p>
              <p class="passkey-item__meta">Added <%= l(credential.created_at.to_date, format: :long) %></p>
            </div>

            <div class="passkey-item__actions">
              <%= form_with url: passkey_path(credential), method: :patch, local: true, class: "passkey-item__rename" do %>
                <%= text_field_tag "passkey_credential[nickname]", credential.nickname,
                      class: "form-input", placeholder: "Name this passkey", aria: { label: "Rename passkey" } %>
                <%= submit_tag "Save", class: "btn btn--secondary btn--sm" %>
              <% end %>

              <% if @passkey_management_unlocked %>
                <%= link_to "Remove", passkey_path(credential),
                      class: "btn btn--danger btn--sm",
                      data: { turbo_method: :delete, turbo_confirm: "Remove this passkey?" } %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="empty-state mt-4">
        You haven't added any passkeys yet. Add one to make future sign-ins faster.
      </div>
    <% end %>
  </section>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Networks and browsers we remember</h2>
    <p class="card-subtitle">
      Each time you sign in or confirm it's you, we record the network you were
      on and the kind of browser you were using, so we can tell when a sign-in
      doesn't look like one of yours and ask you to confirm it. A network
      entry below isn't your address, but it isn't nothing either — it's the
      block of addresses your provider was using at the time, which can place
      you within a city or a neighborhood. We keep each entry for 90 days
      after it was last used, then delete it automatically.
    </p>
  </div>

  <% if @known_contexts.any? %>
    <ul class="passkey-list">
      <% @known_contexts.each do |context| %>
        <li class="passkey-item">
          <div class="passkey-item__body">
            <p class="passkey-item__name"><%= describe_known_context_device(context.device_fingerprint) %></p>
            <p class="passkey-item__meta">
              Network <%= context.ip_prefix.presence || "unknown" %>
              &middot; Last used <%= l(context.last_seen_at.to_date, format: :long) %>
            </p>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="empty-state mt-4">
      We haven't recorded any networks or browsers for your account yet.
    </div>
  <% end %>
</div>
