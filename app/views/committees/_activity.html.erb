<section class="committee-article-section" id="recent-work">
  <div class="home-section-header">
    <%= render "shared/atom_marker" %>
    <h2 class="section-label"><%= council ? "Recent Council work" : "What They've Been Working On" %></h2>
    <span class="section-line"></span>
  </div>

  <% unless gated_for_visitor? %>
    <%= gated_content do %>
      <% if @recent_topics.any? %>
        <div class="committee-activity">
          <% @recent_topics.each do |topic| %>
            <% headline = @headlines[topic.id] %>
            <%= link_to topic_path(topic), class: "committee-activity-item" do %>
              <div class="committee-activity-header">
                <span class="committee-activity-topic"><%= topic.canonical_name %></span>
                <% if topic.respond_to?(:latest_meeting_date) && topic.latest_meeting_date %>
                  <span class="committee-activity-date"><%= short_meeting_date(topic.latest_meeting_date) %></span>
                <% end %>
              </div>
              <% if headline.present? %>
                <p class="committee-activity-headline"><%= truncate(headline, length: 120) %></p>
              <% elsif topic.description.present? %>
                <p class="committee-activity-desc"><%= truncate(topic.description, length: 120) %></p>
              <% end %>
              <span class="committee-activity-cta">Topic details &rarr;</span>
            <% end %>
          <% end %>
        </div>
        <div class="committee-activity-footer">
          <%= link_to "Browse all topics →", topics_path %>
        </div>
      <% else %>
        <p class="section-empty">No recent activity tracked for this committee.</p>
      <% end %>
    <% end %>
  <% end %>
</section>
