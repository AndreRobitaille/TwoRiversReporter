<li id="seat-<%= name.parameterize %>">
  <% member_id = @election_member_ids[name] %>
  <% portrait = @election_portraits[name] %>
  <% image = image_tag(candidate_portrait_path(portrait, v: portrait.image_key), alt: "", class: "candidate-photo") if portrait %>
  <% row = safe_join([tag.span(name), image].compact) %>
  <% if member_id %>
    <%= link_to row, member_path(member_id), class: "election-person-row" %>
  <% else %>
    <span class="election-person-row"><%= row %></span>
    <% if portrait %><small>Photo · <%= link_to portrait.publisher, portrait.source_url %></small><% end %>
  <% end %>
</li>
