<li id="seat-<%= name.parameterize %>">
  <% if (member_id = @election_member_ids[name]) %>
    <%= link_to name, member_path(member_id) %>
  <% else %>
    <%= name %>
  <% end %>
  <% if election.terms_ending.key?(name) && election.candidates.key?(name) %>
    · Confirmed candidate
  <% end %>
</li>
