<%# Mid-tier wire card. Locals: topic, headline, meeting_ref %>
<% generated_image = @topic_generated_images&.[](topic.id) %>
<% has_image = generated_image&.file&.attached? %>
<%= link_to topic_path(topic), class: (has_image ? "wire-card wire-card--with-image" : "wire-card") do %>
  <% if has_image %>
    <div class="wire-media">
      <% dimensions = generated_image_dimensions(size: :compact) %>
      <%= image_tag generated_image_proxy_path(generated_image, size: :compact),
        alt: "Illustration for #{topic.name}",
        class: "wire-image",
        loading: "lazy",
        decoding: "async",
        width: dimensions[:width],
        height: dimensions[:height] %>
    </div>
  <% end %>
  <div class="wire-body">
    <div class="wire-topic"><%= topic.name %></div>
    <% if headline.present? %>
      <%# Two different jobs, so two branches rather than one nested call: the
          120-char truncate is a layout cap for people allowed to read the
          whole headline, the teaser is an access cut. Composing them
          (teasing an already-truncated string) would work but reads as a
          double truncation with one boundary that never fires. %>
      <p class="wire-headline"><% if gated_for_visitor? %><%= teaser(headline, chars: HomeHelper::GATED_CARD_HEADLINE_CHARS, fade: :inline) %> <%= render "home/signin_note" %><% else %><%= truncate(headline, length: 120) %><% end %></p>
    <% end %>
    <div class="wire-footer">
      <% if meeting_ref %>
        <span class="wire-meta"><%= meeting_ref[:date]&.strftime("%b %-d") %> · <%= meeting_ref[:body_name]&.sub(/ Meeting$/, "") %></span>
      <% else %>
        <span class="wire-meta"></span>
      <% end %>
      <span class="wire-read">Full story →</span>
    </div>
  </div>
<% end %>
