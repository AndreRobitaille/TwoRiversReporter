#!/bin/sh
set -eu

if [ "$#" -ne 3 ]; then
  echo "Usage: smoke_runtime_image RUBY_VERSION DENO_VERSION YT_DLP_VERSION" >&2
  exit 1
fi

check_version() {
  if [ "$2" != "$3" ]; then
    echo "$1 version mismatch: expected $2, got $3" >&2
    exit 1
  fi
  echo "$1 $3"
}

check_version Ruby "$1" "$(ruby -e 'print RUBY_VERSION')"
check_version Deno "$2" "$(deno --version | sed -n '1s/^deno \([^ ]*\).*/\1/p')"
check_version yt-dlp "$3" "$(yt-dlp --version)"

bin/rails runner 'Rails.application.eager_load!; abort "Rails did not initialize" unless Rails.application.initialized?; puts "Rails production boot: #{Rails.version}"'
