{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    "docs/DEVELOPMENT_PLAN.md",
    "docs/topics/TOPIC_GOVERNANCE.md",
    "docs/plans/2026-03-28-atomic-design-system-spec.md"
  ],
  "command": {
    "setup": {
      "description": "Install dependencies and prepare the database.",
      "template": "Run `bin/setup --skip-server` and report any failures."
    },
    "dev": {
      "description": "Start the Rails development server.",
      "template": "Run `bin/dev`."
    },
    "jobs": {
      "description": "Start the background job worker.",
      "template": "Run `bin/jobs`."
    },
    "test": {
      "description": "Run the Rails test suite.",
      "template": "Run `bin/rails test` and summarize the result."
    },
    "lint": {
      "description": "Run RuboCop style checks.",
      "template": "Run `bin/rubocop` and summarize the result."
    },
    "audit": {
      "description": "Run dependency and importmap security audits.",
      "template": "Run `bin/bundler-audit` and `bin/importmap audit`, then summarize the result."
    },
    "check": {
      "description": "Run local CI checks.",
      "template": "Run `bin/ci` and summarize setup, application tests, lint, dependency audits, and Brakeman results."
    },
    "security": {
      "description": "Run the Brakeman security scan.",
      "template": "Run `bin/brakeman --no-pager` and summarize the result."
    }
  }
}
